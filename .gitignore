# OS files
.DS_Store
Thumbs.db

# Editor/IDE
*.swp
*~

# Logs
*.log

# Wrangler local state
.wrangler/

# Node / Capacitor
node_modules/
# generated by `npm run build` from the allowlist in scripts/build-www.mjs
www/
# rasterised from the .svg sources by scripts/make-assets.mjs
resources/*.png
.gradle/
*.keystore
*.jks

# android/ is committed, per Capacitor's recommendation — it carries the native config and is
# where signing settings land. It has its own .gitignore covering build output, .gradle/,
# local.properties and the web assets that `cap sync` regenerates.
# ios/ does not exist yet; generate it with `npx cap add ios` on a Mac, then drop this line.
/ios/

# Personal reference photos (kept local, not published)
PXL_*.jpg


# Store screenshots are regenerated by `npm run screenshots`
store-assets/screenshots/
