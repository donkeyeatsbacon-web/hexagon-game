# Copy this file to android/keystore.properties and fill in your own values.
#
#   cp android/keystore.properties.example android/keystore.properties
#
# keystore.properties is gitignored — it contains passwords. Never commit it, and never
# commit the .jks file itself.
#
# Create the upload keystore first:
#
#   keytool -genkeypair -v -keystore ~/hexagon-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias hexagon
#
# Generate the password locally rather than inventing one — you never type it by hand, it
# just lives in this file:
#
#   openssl rand -base64 24
#
# Press RETURN at keytool's "key password" prompt so it matches the store password. Don't
# pass -storepass on the command line; it lands in your shell history.
#
# BACK THE .jks FILE UP OFF THIS MACHINE, together with its password — one without the other
# is useless. Store both in a password manager.
#
# This is an UPLOAD key, not the app signing key. New apps are enrolled in Play App Signing,
# where Google holds the actual signing key, so losing this one means requesting an upload
# key reset through Play Console support: slow and irritating, but recoverable. It is only
# unrecoverable if you opt out of Play App Signing and manage the signing key yourself —
# so don't opt out.

# Absolute path to the keystore (~ is not expanded — write the full path).
storeFile=/home/bfox/hexagon-release.jks

# The password you gave the keystore.
storePassword=

# The -alias value used above.
keyAlias=hexagon

# The key password. keytool usually makes this the same as storePassword.
keyPassword=
