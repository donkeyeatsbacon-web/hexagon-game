# Copy this file to android/keystore.properties and fill in your own values.
#
#   cp android/keystore.properties.example android/keystore.properties
#
# keystore.properties is gitignored — it contains passwords. Never commit it, and never
# commit the .jks file itself.
#
# Create the upload keystore first:
#
#   keytool -genkeypair -v -keystore ~/hexagon-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias hexagon
#
# BACK THE .jks FILE UP SOMEWHERE OFF THIS MACHINE. If you lose it you can never publish an
# update to this app again — Play would require a new package name and a new listing, and
# your existing users could not be migrated.

# Absolute path to the keystore (~ is not expanded — write the full path).
storeFile=/home/bfox/hexagon-release.jks

# The password you gave the keystore.
storePassword=

# The -alias value used above.
keyAlias=hexagon

# The key password. keytool usually makes this the same as storePassword.
keyPassword=
